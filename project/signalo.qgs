              <dd_properties>
                <Option type="Map">
                  <Option name="name" type="QString" value=""></Option>
                  <Option name="properties" type="Map">
                    <Option name="BufferSize" type="Map">
                      <Option name="active" type="bool" value="true"></Option>
                      <Option name="expression" type="QString" value="min(6.35/4, (scale_linear(@vector_tile_zoom,14,17,1,2)) * 0.529167)"></Option>
                      <Option name="type" type="int" value="3"></Option>
                    </Option>
                    <Option name="Color" type="Map">
                      <Option name="active" type="bool" value="true"></Option>
                      <Option name="expression" type="QString" value="CASE WHEN &quot;subclass&quot; IN ('ferry','car_ferry','ferry_terminal') THEN '#2f86bc' WHEN &quot;subclass&quot; IN ('funicular_stop','halt','tram_stop','bus_stop','cable_car_station','gondola_station','chair_lift_station','aerialway_station','elevator','subway_entrance','subway_stop') THEN '#ff3232' WHEN &quot;subclass&quot; IN ('weir','waterfall') THEN '#2f86bc' ELSE '#303030' END"></Option>
                      <Option name="type" type="int" value="3"></Option>
                    </Option>
                    <Option name="FontLetterSpacing" type="Map">
                      <Option name="active" type="bool" value="true"></Option>
                      <Option name="expression" type="QString" value="CASE WHEN &quot;class&quot; IS 'park' THEN 0.05 ELSE 0 END"></Option>
                      <Option name="type" type="int" value="3"></Option>
                    </Option>
                    <Option name="OffsetQuad" type="Map">
                      <Option name="active" type="bool" value="true"></Option>
                      <Option name="expression" type="QString" value="CASE WHEN @vector_tile_zoom >  AND @vector_tile_zoom &lt;= get THEN NULL WHEN @vector_tile_zoom > get AND @vector_tile_zoom &lt;= caravan_site THEN 'subclass' WHEN @vector_tile_zoom > caravan_site AND @vector_tile_zoom &lt;=  THEN 'camp_site' WHEN @vector_tile_zoom >  AND @vector_tile_zoom &lt;= ferry THEN NULL WHEN @vector_tile_zoom > ferry AND @vector_tile_zoom &lt;=  THEN 'car_ferry' WHEN @vector_tile_zoom >  AND @vector_tile_zoom &lt;=  THEN NULL ELSE NULL END"></Option>
                      <Option name="type" type="int" value="3"></Option>
                    </Option>
                    <Option name="Size" type="Map">
                      <Option name="active" type="bool" value="true"></Option>
