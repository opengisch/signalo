                <rule symbol="0" label="Signaux" filter=" (&#xa; &#xa;--   4.  Signaux d'indication&#xa;-- 4.1 Signaux impliquant des règles de comportement (4.01-4.25)&#xa;(&quot;sign_fk_official_sign&quot; like '4.0%' &#xa;or &quot;sign_fk_official_sign&quot; like '4.1%'&#xa;or &quot;sign_fk_official_sign&quot; in ('4.20','4.22','4.23','4.24')&#xa;or &quot;sign_fk_official_sign&quot; like '4.21%'&#xa;or &quot;sign_fk_official_sign&quot; like '4.25%')&#xa;&#xa;&#xa;-- 4.2 Direction indication signs on main roads and secondary roads (4.27-4.59.1)&#xa;&#xa;or &#xa;(&quot;sign_fk_official_sign&quot; like '4.27%' &#xa;or &quot;sign_fk_official_sign&quot; = '4.28'&#xa;or &quot;sign_fk_official_sign&quot; like '4.29%' &#xa;or &quot;sign_fk_official_sign&quot; like '4.3%'&#xa;or &quot;sign_fk_official_sign&quot; like '4.4%'&#xa;or &quot;sign_fk_official_sign&quot; like '4.5%')&#xa;&#xa;-- 4.3 Direction indication signs motorways and semi-motorways (4.60-4.73)&#xa;or&#xa;(&quot;sign_fk_official_sign&quot; like '4.6%'&#xa;or &quot;sign_fk_official_sign&quot; in ('4.70','4.71','4.72','4.73'))&#xa;&#xa;-- 4.4 Informations (4.75-4.95)&#xa;or &#xa;(&quot;sign_fk_official_sign&quot; in ('4.75','4.76','4.79')&#xa;or &quot;sign_fk_official_sign&quot; like '4.77%'&#xa;or &quot;sign_fk_official_sign&quot; like '4.8%'&#xa;or &quot;sign_fk_official_sign&quot; like '4.9%')&#xa;&#xa;-- keep this parenthesis!&#xa;)" key="{9fb3def5-e8b7-4825-add6-4b0041e8e0a6}"/>
              </rules>
