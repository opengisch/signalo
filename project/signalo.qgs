                        <Option name="enabled" type="Map">
                          <Option name="active" type="bool" value="true"></Option>
                          <Option name="expression" type="QString" value="(CASE WHEN @vector_tile_zoom >= 7 AND @vector_tile_zoom &lt;= 8 THEN (scale_exponential(@vector_tile_zoom,7,8,0,CASE WHEN &quot;is_route&quot; IN (5, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 0.5 ELSE 2 END WHEN &quot;class&quot; = 'trunk' THEN 2 ELSE 2 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 0.5 ELSE 0 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 8 AND @vector_tile_zoom &lt;= 9 THEN (scale_exponential(@vector_tile_zoom,8,9,CASE WHEN &quot;is_route&quot; IN (5, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 0.5 ELSE 2 END WHEN &quot;class&quot; = 'trunk' THEN 2 ELSE 2 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 0.5 ELSE 0 END END,CASE WHEN &quot;is_route&quot; IN (5, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 0.75 ELSE 2.25 END WHEN &quot;class&quot; = 'trunk' THEN 2.25 ELSE 2 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 0.75 ELSE 0 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 9 AND @vector_tile_zoom &lt;= 10 THEN (scale_exponential(@vector_tile_zoom,9,10,CASE WHEN &quot;is_route&quot; IN (5, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 0.75 ELSE 2.25 END WHEN &quot;class&quot; = 'trunk' THEN 2.25 ELSE 2 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 0.75 ELSE 0 END END,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 0.75 ELSE 2.75 END WHEN &quot;class&quot; = 'trunk' THEN 2.75 WHEN (&quot;class&quot; = 'primary') THEN 2.5 WHEN (&quot;class&quot; = 'secondary') THEN 2.5 WHEN (&quot;class&quot; = 'tertiary') THEN 2 WHEN &quot;class&quot; IN ('minor', 'service') THEN 1.5 ELSE 0 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 0.75 ELSE 0 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 10 AND @vector_tile_zoom &lt;= 11 THEN (scale_exponential(@vector_tile_zoom,10,11,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 0.75 ELSE 2.75 END WHEN &quot;class&quot; = 'trunk' THEN 2.75 WHEN (&quot;class&quot; = 'primary') THEN 2.5 WHEN (&quot;class&quot; = 'secondary') THEN 2.5 WHEN (&quot;class&quot; = 'tertiary') THEN 2 WHEN &quot;class&quot; IN ('minor', 'service') THEN 1.5 ELSE 0 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 0.75 ELSE 0 END END,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 1.25 ELSE 3.25 END WHEN &quot;class&quot; = 'trunk' THEN 3.25 WHEN (&quot;class&quot; = 'primary') THEN 3 WHEN (&quot;class&quot; = 'secondary') THEN 3 WHEN (&quot;class&quot; = 'tertiary') THEN 2.5 WHEN &quot;class&quot; IN ('minor', 'service') THEN 1.75 ELSE 0 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 1.25 ELSE 0 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 11 AND @vector_tile_zoom &lt;= 12 THEN (scale_exponential(@vector_tile_zoom,11,12,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 1.25 ELSE 3.25 END WHEN &quot;class&quot; = 'trunk' THEN 3.25 WHEN (&quot;class&quot; = 'primary') THEN 3 WHEN (&quot;class&quot; = 'secondary') THEN 3 WHEN (&quot;class&quot; = 'tertiary') THEN 2.5 WHEN &quot;class&quot; IN ('minor', 'service') THEN 1.75 ELSE 0 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 1.25 ELSE 0 END END,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 1.5 ELSE 3.75 END WHEN &quot;class&quot; = 'trunk' THEN 3.75 WHEN (&quot;class&quot; = 'primary') THEN 4 WHEN (&quot;class&quot; = 'secondary') THEN 3.5 WHEN (&quot;class&quot; = 'tertiary') THEN 3 WHEN &quot;class&quot; IN ('minor', 'service') THEN 2 ELSE 0 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 1.5 ELSE 0 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 12 AND @vector_tile_zoom &lt;= 13 THEN (scale_exponential(@vector_tile_zoom,12,13,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 1.5 ELSE 3.75 END WHEN &quot;class&quot; = 'trunk' THEN 3.75 WHEN (&quot;class&quot; = 'primary') THEN 4 WHEN (&quot;class&quot; = 'secondary') THEN 3.5 WHEN (&quot;class&quot; = 'tertiary') THEN 3 WHEN &quot;class&quot; IN ('minor', 'service') THEN 2 ELSE 0 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 1.5 ELSE 0 END END,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 1.75 ELSE 4.5 END WHEN &quot;class&quot; = 'trunk' THEN 4.5 WHEN (&quot;class&quot; = 'primary') THEN 4.5 WHEN (&quot;class&quot; = 'secondary') THEN 4 WHEN (&quot;class&quot; = 'tertiary') THEN 3.5 WHEN &quot;class&quot; IN ('minor', 'service') THEN 2.5 ELSE 2 END WHEN (&quot;is_route&quot; = 11) THEN CASE WHEN &quot;class&quot; IN ('motorway', 'trunk') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 1.75 ELSE 4.5 END WHEN (&quot;class&quot; = 'primary') THEN 3 WHEN (&quot;class&quot; = 'secondary') THEN 2.75 WHEN (&quot;class&quot; = 'tertiary') THEN 2.75 WHEN &quot;class&quot; IN ('minor', 'service') THEN 2 ELSE 2 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 1.75 ELSE 0 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 13 AND @vector_tile_zoom &lt;= 14 THEN (scale_exponential(@vector_tile_zoom,13,14,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 1.75 ELSE 4.5 END WHEN &quot;class&quot; = 'trunk' THEN 4.5 WHEN (&quot;class&quot; = 'primary') THEN 4.5 WHEN (&quot;class&quot; = 'secondary') THEN 4 WHEN (&quot;class&quot; = 'tertiary') THEN 3.5 WHEN &quot;class&quot; IN ('minor', 'service') THEN 2.5 ELSE 2 END WHEN (&quot;is_route&quot; = 11) THEN CASE WHEN &quot;class&quot; IN ('motorway', 'trunk') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 1.75 ELSE 4.5 END WHEN (&quot;class&quot; = 'primary') THEN 3 WHEN (&quot;class&quot; = 'secondary') THEN 2.75 WHEN (&quot;class&quot; = 'tertiary') THEN 2.75 WHEN &quot;class&quot; IN ('minor', 'service') THEN 2 ELSE 2 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 1.75 ELSE 0 END END,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2.75 ELSE 5.5 END WHEN &quot;class&quot; = 'trunk' THEN 5.5 WHEN (&quot;class&quot; = 'primary') THEN 5.5 WHEN (&quot;class&quot; = 'secondary') THEN 5 WHEN (&quot;class&quot; = 'tertiary') THEN 4 WHEN &quot;class&quot; IN ('minor', 'service') THEN 3 ELSE 2.5 END ELSE CASE WHEN &quot;class&quot; IN ('motorway', 'trunk') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2.75 ELSE 5.5 END WHEN (&quot;class&quot; = 'primary') THEN 3.5 WHEN (&quot;class&quot; = 'secondary') THEN 3 WHEN (&quot;class&quot; = 'tertiary') THEN 3 WHEN &quot;class&quot; IN ('minor', 'service') THEN 2.5 ELSE 2.5 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 14 AND @vector_tile_zoom &lt;= 15 THEN (scale_exponential(@vector_tile_zoom,14,15,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2.75 ELSE 5.5 END WHEN &quot;class&quot; = 'trunk' THEN 5.5 WHEN (&quot;class&quot; = 'primary') THEN 5.5 WHEN (&quot;class&quot; = 'secondary') THEN 5 WHEN (&quot;class&quot; = 'tertiary') THEN 4 WHEN &quot;class&quot; IN ('minor', 'service') THEN 3 ELSE 2.5 END ELSE CASE WHEN &quot;class&quot; IN ('motorway', 'trunk') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2.75 ELSE 5.5 END WHEN (&quot;class&quot; = 'primary') THEN 3.5 WHEN (&quot;class&quot; = 'secondary') THEN 3 WHEN (&quot;class&quot; = 'tertiary') THEN 3 WHEN &quot;class&quot; IN ('minor', 'service') THEN 2.5 ELSE 2.5 END END,CASE WHEN (&quot;subclass&quot; = 'funicular') THEN 3 ELSE CASE WHEN &quot;class&quot; IN ('motorway', 'motorway_construction') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 5 ELSE 6.5 END WHEN &quot;class&quot; IN ('trunk', 'trunk_construction') THEN CASE WHEN (&quot;oneway&quot; = 1) THEN 6.5 ELSE 10.5 END WHEN &quot;class&quot; IN ('primary', 'primary_construction') THEN 6.5 WHEN &quot;class&quot; IN ('secondary', 'secondary_construction') THEN 5.5 WHEN &quot;class&quot; IN ('tertiary', 'tertiary_construction') THEN 4.5 WHEN &quot;class&quot; IN ('minor', 'minor_construction', 'service', 'service_construction') THEN 3.5 WHEN &quot;class&quot; IN ('rail', 'rail_construction') THEN 5 WHEN &quot;class&quot; IN ('track', 'track_construction', 'path', 'path_construction', 'footway', 'footway_construction', 'transit', 'transit_construction') THEN 1.25 ELSE 3 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 15 AND @vector_tile_zoom &lt;= 16 THEN (scale_exponential(@vector_tile_zoom,15,16,CASE WHEN (&quot;subclass&quot; = 'funicular') THEN 3 ELSE CASE WHEN &quot;class&quot; IN ('motorway', 'motorway_construction') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 5 ELSE 6.5 END WHEN &quot;class&quot; IN ('trunk', 'trunk_construction') THEN CASE WHEN (&quot;oneway&quot; = 1) THEN 6.5 ELSE 10.5 END WHEN &quot;class&quot; IN ('primary', 'primary_construction') THEN 6.5 WHEN &quot;class&quot; IN ('secondary', 'secondary_construction') THEN 5.5 WHEN &quot;class&quot; IN ('tertiary', 'tertiary_construction') THEN 4.5 WHEN &quot;class&quot; IN ('minor', 'minor_construction', 'service', 'service_construction') THEN 3.5 WHEN &quot;class&quot; IN ('rail', 'rail_construction') THEN 5 WHEN &quot;class&quot; IN ('track', 'track_construction', 'path', 'path_construction', 'footway', 'footway_construction', 'transit', 'transit_construction') THEN 1.25 ELSE 3 END END,CASE WHEN (&quot;subclass&quot; = 'funicular') THEN 6 ELSE CASE WHEN &quot;class&quot; IN ('motorway', 'motorway_construction') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 8 ELSE 10 END WHEN &quot;class&quot; IN ('trunk', 'trunk_construction') THEN CASE WHEN (&quot;oneway&quot; = 1) THEN 10 ELSE 13 END WHEN &quot;class&quot; IN ('primary', 'primary_construction') THEN 10 WHEN &quot;class&quot; IN ('secondary', 'secondary_construction') THEN 9 WHEN &quot;class&quot; IN ('tertiary', 'tertiary_construction') THEN 8 WHEN &quot;class&quot; IN ('minor', 'minor_construction', 'service', 'service_construction') THEN 7 WHEN &quot;class&quot; IN ('rail', 'rail_construction') THEN 9.5 WHEN &quot;class&quot; IN ('track', 'track_construction', 'path', 'path_construction', 'footway', 'footway_construction', 'transit', 'transit_construction') THEN 6.5 ELSE 6 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 16 AND @vector_tile_zoom &lt;= 20 THEN (scale_exponential(@vector_tile_zoom,16,20,CASE WHEN (&quot;subclass&quot; = 'funicular') THEN 6 ELSE CASE WHEN &quot;class&quot; IN ('motorway', 'motorway_construction') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 8 ELSE 10 END WHEN &quot;class&quot; IN ('trunk', 'trunk_construction') THEN CASE WHEN (&quot;oneway&quot; = 1) THEN 10 ELSE 13 END WHEN &quot;class&quot; IN ('primary', 'primary_construction') THEN 10 WHEN &quot;class&quot; IN ('secondary', 'secondary_construction') THEN 9 WHEN &quot;class&quot; IN ('tertiary', 'tertiary_construction') THEN 8 WHEN &quot;class&quot; IN ('minor', 'minor_construction', 'service', 'service_construction') THEN 7 WHEN &quot;class&quot; IN ('rail', 'rail_construction') THEN 9.5 WHEN &quot;class&quot; IN ('track', 'track_construction', 'path', 'path_construction', 'footway', 'footway_construction', 'transit', 'transit_construction') THEN 6.5 ELSE 6 END END,CASE WHEN (&quot;subclass&quot; = 'funicular') THEN 20 ELSE CASE WHEN &quot;class&quot; IN ('motorway', 'motorway_construction') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 112 ELSE 126 END WHEN &quot;class&quot; IN ('trunk', 'trunk_construction') THEN CASE WHEN (&quot;oneway&quot; = 1) THEN 126 ELSE 136 END WHEN &quot;class&quot; IN ('primary', 'primary_construction') THEN 117 WHEN &quot;class&quot; IN ('secondary', 'secondary_construction') THEN 112 WHEN &quot;class&quot; IN ('tertiary', 'tertiary_construction') THEN 107 WHEN &quot;class&quot; IN ('minor', 'minor_construction', 'service', 'service_construction') THEN 97 WHEN &quot;class&quot; IN ('rail', 'rail_construction') THEN 120 WHEN &quot;class&quot; IN ('track', 'track_construction', 'path', 'path_construction', 'footway', 'footway_construction', 'transit', 'transit_construction') THEN 81 ELSE 92 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 20 THEN ( ( CASE WHEN (&quot;subclass&quot; = 'funicular') THEN 20 ELSE CASE WHEN &quot;class&quot; IN ('motorway', 'motorway_construction') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 112 ELSE 126 END WHEN &quot;class&quot; IN ('trunk', 'trunk_construction') THEN CASE WHEN (&quot;oneway&quot; = 1) THEN 126 ELSE 136 END WHEN &quot;class&quot; IN ('primary', 'primary_construction') THEN 117 WHEN &quot;class&quot; IN ('secondary', 'secondary_construction') THEN 112 WHEN &quot;class&quot; IN ('tertiary', 'tertiary_construction') THEN 107 WHEN &quot;class&quot; IN ('minor', 'minor_construction', 'service', 'service_construction') THEN 97 WHEN &quot;class&quot; IN ('rail', 'rail_construction') THEN 120 WHEN &quot;class&quot; IN ('track', 'track_construction', 'path', 'path_construction', 'footway', 'footway_construction', 'transit', 'transit_construction') THEN 81 ELSE 92 END END ) * 0.264583 ) END) > 0"></Option>
