                          <Option name="expression" type="QString" value="CASE WHEN @vector_tile_zoom >= 9 AND @vector_tile_zoom &lt;= 10 THEN (scale_linear(@vector_tile_zoom,9,10,CASE WHEN (&quot;is_route&quot; = 99) THEN CASE WHEN (&quot;subclass&quot; = 'rail') THEN 0.75 ELSE 0 END ELSE 0 END,CASE WHEN (&quot;is_route&quot; = 99) THEN CASE WHEN &quot;class&quot; = 'rail' THEN CASE WHEN &quot;subclass&quot; IN ('rail', 'narrow_gauge', 'rack_rail') THEN CASE WHEN &quot;service&quot; IN ('yard', 'siding') THEN 0 ELSE 0.75 END ELSE 0.5 END ELSE 0.5 END ELSE CASE WHEN &quot;subclass&quot; IN ('cable_car', 'funicular') THEN 0.75 ELSE 0 END END)) * 0.264583 WHEN @vector_tile_zoom > 10 AND @vector_tile_zoom &lt;= 14 THEN (scale_linear(@vector_tile_zoom,10,14,CASE WHEN (&quot;is_route&quot; = 99) THEN CASE WHEN &quot;class&quot; = 'rail' THEN CASE WHEN &quot;subclass&quot; IN ('rail', 'narrow_gauge', 'rack_rail') THEN CASE WHEN &quot;service&quot; IN ('yard', 'siding') THEN 0 ELSE 0.75 END ELSE 0.5 END ELSE 0.5 END ELSE CASE WHEN &quot;subclass&quot; IN ('cable_car', 'funicular') THEN 0.75 ELSE 0 END END,CASE WHEN (&quot;is_route&quot; = 99) THEN CASE WHEN (&quot;class&quot; = 'transit') THEN 1 WHEN &quot;class&quot; = 'rail' THEN CASE WHEN &quot;subclass&quot; IN ('rail', 'narrow_gauge', 'rack_rail') THEN 2 ELSE 1 END ELSE 0 END ELSE CASE WHEN &quot;subclass&quot; IN ('cable_car', 'funicular') THEN 1 ELSE 0 END END)) * 0.264583 WHEN @vector_tile_zoom > 14 AND @vector_tile_zoom &lt;= 18 THEN (scale_linear(@vector_tile_zoom,14,18,CASE WHEN (&quot;is_route&quot; = 99) THEN CASE WHEN (&quot;class&quot; = 'transit') THEN 1 WHEN &quot;class&quot; = 'rail' THEN CASE WHEN &quot;subclass&quot; IN ('rail', 'narrow_gauge', 'rack_rail') THEN 2 ELSE 1 END ELSE 0 END ELSE CASE WHEN &quot;subclass&quot; IN ('cable_car', 'funicular') THEN 1 ELSE 0 END END,CASE WHEN &quot;class&quot; = 'transit' THEN 1.5 ELSE CASE WHEN &quot;service&quot; IN ('yard', 'siding') THEN 1.5 ELSE 2 END END)) * 0.264583 WHEN @vector_tile_zoom > 18 THEN ( ( CASE WHEN &quot;class&quot; = 'transit' THEN 1.5 ELSE CASE WHEN &quot;service&quot; IN ('yard', 'siding') THEN 1.5 ELSE 2 END END ) * 0.264583 ) END"></Option>
                          <Option name="type" type="int" value="3"></Option>
