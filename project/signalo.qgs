uction') THEN CASE WHEN (&quot;subclass&quot; = 'covered_bridge') THEN 8.5 ELSE 1.1 END ELSE 8 END,2)) * 0.264583 WHEN @vector_tile_zoom > 16 AND @vector_tile_zoom &lt;= 20 THEN (scale_exponential(@vector_tile_zoom,16,20,CASE WHEN &quot;class&quot; IN ('motorway', 'motorway_construction') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 10 ELSE 12 END WHEN &quot;class&quot; IN ('trunk', 'trunk_construction') THEN CASE WHEN (&quot;oneway&quot; = 1) THEN 12 ELSE 15 END WHEN &quot;class&quot; IN ('primary', 'primary_construction') THEN 12 WHEN &quot;class&quot; IN ('secondary', 'secondary_construction') THEN 11 WHEN &quot;class&quot; IN ('tertiary', 'tertiary_construction') THEN 10 WHEN &quot;class&quot; IN ('minor', 'minor_construction', 'service', 'service_construction', 'rail', 'rail_construction') THEN 9 WHEN &quot;class&quot; IN ('track', 'track_construction', 'path', 'path_construction', 'footway', 'footway_construction', 'transit', 'transit_construction') THEN CASE WHEN (&quot;subclass&quot; = 'covered_bridge') THEN 8.5 ELSE 1.1 END ELSE 8 END,CASE WHEN &quot;class&quot; IN ('motorway', 'motorway_construction') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 115 ELSE 130 END WHEN &quot;class&quot; IN ('trunk', 'trunk_construction') THEN CASE WHEN (&quot;oneway&quot; = 1) THEN 130 ELSE 140 END WHEN &quot;class&quot; IN ('primary', 'primary_construction') THEN 120 WHEN &quot;class&quot; IN ('secondary', 'secondary_construction') THEN 115 WHEN &quot;class&quot; IN ('tertiary', 'tertiary_construction') THEN 110 WHEN &quot;class&quot; IN ('minor', 'minor_construction', 'service', 'service_construction', 'rail', 'rail_construction') THEN 100 WHEN &quot;class&quot; IN ('track', 'track_construction', 'path', 'path_construction', 'footway', 'footway_construction', 'transit', 'transit_construction') THEN CASE WHEN (&quot;subclass&quot; = 'covered_bridge') THEN 84 ELSE 5 END ELSE 100 END,2)) * 0.264583 WHEN @vector_tile_zoom > 20 THEN ( ( CASE WHEN &quot;class&quot; IN ('motorway', '