                          <Option name="expression" type="QString" value="(CASE WHEN @vector_tile_zoom >= 12 AND @vector_tile_zoom &lt;= 14 THEN (scale_linear(@vector_tile_zoom,12,14,CASE WHEN (&quot;lake_depth&quot; IS NOT NULL) THEN CASE WHEN (&quot;&quot; = 0) THEN 0.75 ELSE 0 END ELSE CASE WHEN (&quot;&quot; = 0) THEN 0.75 ELSE 0 END END,CASE WHEN (&quot;lake_depth&quot; IS NOT NULL) THEN CASE WHEN (&quot;&quot; = 0) THEN 1 ELSE 0 END ELSE CASE WHEN (&quot;&quot; = 0) THEN 1 ELSE 0 END END)) * 0.264583 WHEN @vector_tile_zoom > 14 AND @vector_tile_zoom &lt;= 15 THEN (scale_linear(@vector_tile_zoom,14,15,CASE WHEN (&quot;lake_depth&quot; IS NOT NULL) THEN CASE WHEN (&quot;&quot; = 0) THEN 1 ELSE 0 END ELSE CASE WHEN (&quot;&quot; = 0) THEN 1 ELSE 0 END END,CASE WHEN (&quot;lake_depth&quot; IS NOT NULL) THEN CASE WHEN (&quot;&quot; = 0) THEN 1.5 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 0.75 ELSE 0 END ELSE CASE WHEN (&quot;&quot; = 0) THEN 1.5 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 0.75 ELSE 0 END END)) * 0.264583 WHEN @vector_tile_zoom > 15 AND @vector_tile_zoom &lt;= 18 THEN (scale_linear(@vector_tile_zoom,15,18,CASE WHEN (&quot;lake_depth&quot; IS NOT NULL) THEN CASE WHEN (&quot;&quot; = 0) THEN 1.5 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 0.75 ELSE 0 END ELSE CASE WHEN (&quot;&quot; = 0) THEN 1.5 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 0.75 ELSE 0 END END,CASE WHEN (&quot;lake_depth&quot; IS NOT NULL) THEN CASE WHEN (&quot;&quot; = 0) THEN 2 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 1.5 ELSE 1 END ELSE CASE WHEN (&quot;&quot; = 0) THEN 2 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 1.5 ELSE 1 END END)) * 0.264583 WHEN @vector_tile_zoom > 18 THEN ( ( CASE WHEN (&quot;lake_depth&quot; IS NOT NULL) THEN CASE WHEN (&quot;&quot; = 0) THEN 2 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 1.5 ELSE 1 END ELSE CASE WHEN (&quot;&quot; = 0) THEN 2 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 1.5 ELSE 1 END END ) * 0.264583 ) END) > 0"></Option>
                          <Option name="type" type="int" value="3"></Option>
                        </Option>
                        <Option name="outlineColor" type="Map">
                          <Option name="active" type="bool" value="true"></Option>
                          <Option name="expression" type="QString" value="set_color_part(@symbol_color, 'alpha', scale_linear(@vector_tile_zoom,13,14,(CASE WHEN &quot;class&quot; IN ('scree', 'ice', 'water') THEN 0.25 ELSE 0.45 END) * 255,(CASE WHEN &quot;class&quot; IN ('scree', 'ice', 'water') THEN 0.3 ELSE 0.55 END) * 255))"></Option>
                          <Option name="type" type="int" value="3"></Option>
                        </Option>
                        <Option name="outlineWidth" type="Map">
                          <Option name="active" type="bool" value="true"></Option>
                          <Option name="expression" type="QString" value="CASE WHEN @vector_tile_zoom >= 12 AND @vector_tile_zoom &lt;= 14 THEN (scale_linear(@vector_tile_zoom,12,14,CASE WHEN (&quot;lake_depth&quot; IS NOT NULL) THEN CASE WHEN (&quot;&quot; = 0) THEN 0.75 ELSE 0 END ELSE CASE WHEN (&quot;&quot; = 0) THEN 0.75 ELSE 0 END END,CASE WHEN (&quot;lake_depth&quot; IS NOT NULL) THEN CASE WHEN (&quot;&quot; = 0) THEN 1 ELSE 0 END ELSE CASE WHEN (&quot;&quot; = 0) THEN 1 ELSE 0 END END)) * 0.264583 WHEN @vector_tile_zoom > 14 AND @vector_tile_zoom &lt;= 15 THEN (scale_linear(@vector_tile_zoom,14,15,CASE WHEN (&quot;lake_depth&quot; IS NOT NULL) THEN CASE WHEN (&quot;&quot; = 0) THEN 1 ELSE 0 END ELSE CASE WHEN (&quot;&quot; = 0) THEN 1 ELSE 0 END END,CASE WHEN (&quot;lake_depth&quot; IS NOT NULL) THEN CASE WHEN (&quot;&quot; = 0) THEN 1.5 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 0.75 ELSE 0 END ELSE CASE WHEN (&quot;&quot; = 0) THEN 1.5 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 0.75 ELSE 0 END END)) * 0.264583 WHEN @vector_tile_zoom > 15 AND @vector_tile_zoom &lt;= 18 THEN (scale_linear(@vector_tile_zoom,15,18,CASE WHEN (&quot;lake_depth&quot; IS NOT NULL) THEN CASE WHEN (&quot;&quot; = 0) THEN 1.5 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 0.75 ELSE 0 END ELSE CASE WHEN (&quot;&quot; = 0) THEN 1.5 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 0.75 ELSE 0 END END,CASE WHEN (&quot;lake_depth&quot; IS NOT NULL) THEN CASE WHEN (&quot;&quot; = 0) THEN 2 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 1.5 ELSE 1 END ELSE CASE WHEN (&quot;&quot; = 0) THEN 2 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 1.5 ELSE 1 END END)) * 0.264583 WHEN @vector_tile_zoom > 18 THEN ( ( CASE WHEN (&quot;lake_depth&quot; IS NOT NULL) THEN CASE WHEN (&quot;&quot; = 0) THEN 2 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 1.5 ELSE 1 END ELSE CASE WHEN (&quot;&quot; = 0) THEN 2 WHEN &quot;&quot; IN (20, 40, 60, 80) THEN 1.5 ELSE 1 END END ) * 0.264583 ) END"></Option>
                          <Option name="type" type="int" value="3"></Option>
