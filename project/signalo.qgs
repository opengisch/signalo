0%20FROM%20joined_tables%20jt%0A%20%20%20%20LEFT%20JOIN%20azimut_n%20az%20ON%20az.azimut%20%3D%20((jt.azimut_azimut%20+%20180)%20%25%20360)%20AND%20az.fk_support%20%3D%20jt.support_id%0A%20%20%20%20WHERE%20jt.sign_fk_hanging_mode%20!%3D%20'recto'%20AND%20jt.support_group_by_mounting_point%20IS%20FALSE%0A),%0A--%20verso,%20grouped%20by%20mounting%20point%0Aordered_verso_grouped%20AS%20(%0A%20%20%20%20SELECT%0A%20%20%20%20%20%20%20%20jt.*,%0A%20%20%20%20%20%20%20%20jt.azimut_azimut%20+%20180%20AS%20_azimut_rectified,%0A%20%20%20%20%20%20%20%20COALESCE(az.offset_x,%20jt.azimut_offset_x_verso)%20AS%20_azimut_offset_x_rectified,%0A%20%20%20%20%20%20%20%20COALESCE(az.offset_y,%20jt.azimut_offset_y_verso)%20AS%20_azimut_offset_y_rectified,%0A%20%20%20%20%20%20%20%20NOT%20jt.sign_natural_direction_or_left%20AS%20_natural_direction_or_left_rectified,%0A%20%20%20%20%20%20%20%201%20AS%20_verso,%0A%20%20%20%20%20%20%20%201000%20+%20ROW_NUMBER()%20OVER%20(PARTITION%20BY%20jt.support_id,%20jt.azimut_azimut,%20jt.frame_fk_mounting_point%20ORDER%20BY%20jt.frame_rank,%20jt.sign_rank)%20AS%20_rank%0A%20%20%20%20FROM%20joined_tables%20jt%0A%20%20%20%20LEFT%20JOIN%20azimut_n%20az%20ON%20az.azimut%20%3D%20((jt.azimut_azimut%20+%20180)%20%25%20360)%20AND%20az.fk_support%20%3D%20jt.support_id%0A%20%20%20%20WHERE%20jt.sign_fk_hanging_mode%20!%3D%20'recto'%20AND%20jt.support_group_by_mounting_point%20IS%20TRUE%0A),%0Aordered_not_grouped%20AS%20(%0A%20%20%20%20SELECT%20*%20FROM%20ordered_recto_not_grouped%0A%20%20%20%20UNION%20ALL%0A%20%20%20%20SELECT%20*%20FROM%20ordered_verso_not_grouped%0A),%0Aordered_grouped%20AS%20(%0A%20%20%20%20SELECT%20*%20FROM%20ordered_recto_grouped%0A%20%20%20%20UNION%20ALL%0A%20%20%20%20SELECT%20*%20FROM%20ordered_verso_grouped%0A),%0Ashifted_not_grouped%20AS%20(%0A%20%20%20%20SELECT%0A%20%20%20%20%20%20%20%20o.*,%0A%20%20%20%20%20%20%20%20ROW_NUMBER()%20OVER%20(PARTITION%20BY%20o.support_id,%20o._azimut_rectified%20ORDER%20BY%20o._rank)%20AS%20_final_rank,%0A%20%20%20%20%20%20%20%20COALESCE(SUM(o._symbol_height)%20OVER%20(PARTITION%20BY%20o.support_id,%20o._azimut_rectified%20ORDER%20BY%20o._rank%20ROWS%20BETWEEN%20UNBOUNDED%20PRECEDING%20AND%201%20PRECEDING),%200)%20AS%20_symbol_shift,%0A%20%20%20%20%20%20%20%20COALESCE(SUM(o._symbol_height)%20OVER%20(PARTITION%20BY%20o.support_id,%20o._azimut_rectified),%200)%20AS%20_group_height,%0A%20%20%20%20%20%20%20%20MAX(o._symbol_width)%20OVER%20(PARTITION%20BY%20o.support_id,%20o._azimut_rectified)%20AS%20_group_width%0A%20%20%20%20FROM%20ordered_not_grouped%20o%0A),%0Ashifted_grouped%20AS%20(%0A%20%20%20%20SELECT%0A%20%20%20%20%20%20%20%20o.*,%0A%20%20%20%20%20%20%20%20ROW_NUMBER()%20OVER%20(PARTITION%20BY%20o.support_id,%20o._azimut_rectified,%20o.frame_fk_mounting_point%20ORDER%20BY%20o._rank)%20AS%20_final_rank,%0A%20%20%20%20%20%20%20%20COALESCE(SUM(o._symbol_height)%20OVER%20(PARTITION%20BY%20o.support_id,%20o._azimut_rectified,%20o.frame_fk_mounting_point%20ORDER%20BY%20o._rank%20ROWS%20BETWEEN%20UNBOUNDED%20PRECEDING%20AND%201%20PRECEDING),%200)%20AS%20_symbol_shift,%0A%20%20%20%20%20%20%20%20COALESCE(SUM(o._symbol_height)%20OVER%20(PARTITION%20BY%20o.support_id,%20o._azimut_rectified,%20o.frame_fk_mounting_point),%200)%20AS%20_group_height,%0A%20%20%20%20%20%20%20%20MAX(o._symbol_width)%20OVER%20(PARTITION%20BY%20o.support_id,%20o._azimut_rectified,%20o.frame_fk_mounting_point)%20AS%20_group_width%0A%20%20%20%20FROM%20ordered_grouped%20o%0A),%0Aunion_view%20AS%20(%0A%20%20%20%20SELECT%20*%20FROM%20shifted_not_grouped%0A%20%20%20%20UNION%20ALL%0A%20%20%20%20SELECT%20*%20FROM%20shifted_grouped%0A),%0Afinal%20AS%20(%0A%20%20%20%20SELECT%0A%20%20%20%20%20%20%20%20uv.*,%0A%20%20%20%20%20%20%20%20uv.id%20%7C%7C%20'-'%20%7C%7C%20CAST(uv._verso%20AS%20INTEGER)%20AS%20pk,%0A%20%20%20%20%20%20%20%20MAX(uv._group_height)%20OVER%20(PARTITION%20BY%20uv.support_id,%20uv.azimut_azimut,%20uv._verso)%20AS%20_max_shift_for_azimut,%0A%20%20%20%20%20%20%20%20CASE%0A%20%20%20%20%20%20%20%20%20%20%20%20WHEN%20uv.directional_sign%20IS%20TRUE%20AND%20(uv.frame_fk_mounting_point,%20uv._natural_direction_or_left_rectified)%20IN%20(%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20('left',%201),%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20('center',%200),%0A%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20('right',%200)%0A%20%20%20%20%20%20%20%20%20%20%20%20)%20THEN%20'_right'%0A%20%20%20%20%20%20%20%20%20%20%20%20ELSE%20''%0A%20%20%20%20%20%20%20%20END%20AS%20_img_direction%0A%20%20%20%20FROM%20union_view%20uv%0A)%0ASELECT%0A%20%20%20%20ROW_NUMBER()%20OVER%20(ORDER%20BY%20id,%20_verso)%20AS%20_vl_fid,%0A%20%20%20%20pk,%0A%20%20%20%20support_geometry,%0A%20%20%20%20sign_inscription_1,%0A%20%20%20%20sign_inscription_2,%0A%20%20%20%20sign_inscription_3,%0A%20%20%20%20sign_fk_sign_type,%0A%20%20%20%20sign_fk_hanging_mode,%0A%20%20%20%20sign_complex,%0A%20%20%20%20sign_fk_official_sign,%0A%20%20%20%20sign_fk_user_sign,%0A%20%20%20%20frame_fk_mounting_point,%0A%20%20%20%20support_fk_support_type,%0A%20%20%20%20directional_sign,%0A%20%20%20%20_symbol_value_fr,%0A%20%20%20%20_img_direction,%0A%20%20%20%20_img_de,%0A%20%20%20%20_img_fr,%0A%20%20%20%20_img_it,%0A%20%20%20%20_img_ro,%0A%20%20%20%20_img_de_right,%0A%20%20%20%20_img_fr_right,%0A%20%20%20%20_img_it_right,%0A%20%20%20%20_img_ro_right,%0A%20%20%20%20_azimut_rectified,%0A%20%20%20%20_azimut_offset_x_rectified,%0A%20%20%20%20_azimut_offset_y_rectified,%0A%20%20%20%20_symbol_height,%0A%20%20%20%20_symbol_width,%0A%20%20%20%20_verso,%0A%20%20%20%20_final_rank,%0A%20%20%20%20_symbol_shift,%0A%20%20%20%20_group_width,%0A%20%20%20%20_max_shift_for_azimut%0AFROM%20final%0A&amp;uid=_vl_fid&amp;geometry=support_geometry" id="Vue_signal__symbologie_hors_ligne__9e4644cf_c9be_4bc8_8e71_f72a40517413" legend_exp="" legend_split_behavior="0">
