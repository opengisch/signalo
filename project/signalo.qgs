                  </Option>
                  <data_defined_properties>
                    <Option type="Map">
                      <Option name="name" type="QString" value=""></Option>
                      <Option name="properties" type="Map">
                        <Option name="enabled" type="Map">
                          <Option name="active" type="bool" value="true"></Option>
                          <Option name="expression" type="QString" value="(CASE WHEN @vector_tile_zoom >= 7 AND @vector_tile_zoom &lt;= 8 THEN (scale_exponential(@vector_tile_zoom,7,8,0,CASE WHEN &quot;is_route&quot; IN (5, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 1.5 ELSE 3 END WHEN &quot;class&quot; = 'trunk' THEN 3 ELSE 3 END ELSE 0 END,2)) * 0.264583 WHEN @vector_tile_zoom > 8 AND @vector_tile_zoom &lt;= 9 THEN (scale_exponential(@vector_tile_zoom,8,9,CASE WHEN &quot;is_route&quot; IN (5, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 1.5 ELSE 3 END WHEN &quot;class&quot; = 'trunk' THEN 3 ELSE 3 END ELSE 0 END,CASE WHEN &quot;is_route&quot; IN (5, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2 ELSE 3.5 END WHEN &quot;class&quot; = 'trunk' THEN 3.5 ELSE 3 END ELSE 0 END,2)) * 0.264583 WHEN @vector_tile_zoom > 9 AND @vector_tile_zoom &lt;= 10 THEN (scale_exponential(@vector_tile_zoom,9,10,CASE WHEN &quot;is_route&quot; IN (5, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2 ELSE 3.5 END WHEN &quot;class&quot; = 'trunk' THEN 3.5 ELSE 3 END ELSE 0 END,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2 ELSE 4 END WHEN &quot;class&quot; = 'trunk' THEN 4 WHEN (&quot;class&quot; = 'primary') THEN 3.5 WHEN (&quot;class&quot; = 'secondary') THEN 3.5 WHEN (&quot;class&quot; = 'tertiary') THEN 3 WHEN &quot;class&quot; IN ('minor', 'service') THEN 2.5 ELSE 0 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 2 ELSE 0 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 10 AND @vector_tile_zoom &lt;= 11 THEN (scale_exponential(@vector_tile_zoom,10,11,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) 