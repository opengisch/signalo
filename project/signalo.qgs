      <id>Vue_signal__symbologie_hors_ligne__9e4644cf_c9be_4bc8_8e71_f72a40517413</id>
      <datasource>?layer_ref=sign_2499f9bd_24a2_4384_b329_dc522a94c545:sign&amp;layer_ref=frame_b99392c7_2b01_4b3a_bde4_f003e2b838e4:frame&amp;layer_ref=azimut_f5e94397_ee15_4ae1_95b8_af8a412676b3:azimut&amp;layer_ref=support_347aa750_1661_498f_a7e8_017adc616ba0:support&amp;layer_ref=official_sign_02419ef5_80b5_48e3_869b_58a12167b0ae:official_sign&amp;layer_ref=vl_user_sign_c625b1d7_23e8_4c2b_a4d4_e027a23ebe9b:user_sign&amp;layer_ref=marker_type_92d19509_ce38_40d9_bac4_eecb4dff3273:marker_type&amp;query=--%20QGIS%20Virtual%20Layer%20port%20of%20signalo_app.vw_sign_symbol.%0A--%0A--%20Mirrors%20datamodel/app/vw_sign_symbol.py%20so%20the%20sign%20symbology%20keeps%20recomputing%0A--%20when%20the%20project%20is%20taken%20offline%20in%20QField,%20where%20the%20PostgreSQL%20view%20is%20only%20a%0A--%20frozen%20snapshot.%20Source%20tables%20are%20referenced%20by%20the%20aliases%20declared%20as%0A--%20%60layer_ref%3D%3Clayerid%3E:%3Calias%3E%60%20in%20the%20layer%20URI,%20so%20this%20file%20needs%20no%20substitution.%0A--%0A--%20Differences%20from%20the%20PostgreSQL%20view,%20all%20deliberate:%0A--%20%20%20*%20only%20the%20columns%20the%20symbology%20consumes%20are%20projected%20(see%20README.md);%0A--%20%20%20*%20%60_vl_fid%60%20is%20added%20because%20the%20virtual%20layer%20provider%20reads%20the%20uid%20column%20as%0A--%20%20%20%20%20int64%20--%20a%20text%20%60pk%60%20would%20collapse%20every%20feature%20onto%20fid%200;%0A--%20%20%20*%20UNION%20ALL%20replaces%20UNION:%20the%20four%20branches%20are%20disjoint%20(grouped/not-grouped%20by%0A--%20%20%20%20%20the%20WHERE%20clause,%20recto/verso%20by%20%60_verso%60),%20so%20no%20row%20can%20be%20deduplicated;%0A--%20%20%20*%20%60::type%60%20casts%20and%20%60false::bool%60%20become%20CAST(...)/0-1,%20and%20the%20cosmetic%0A--%20%20%20%20%20ORDER%20BY%20inside%20the%20branch%20CTEs%20is%20dropped.%0A--%20The%20%60*_n%60%20CTEs%20exist%20for%20one%20reason.%20The%20virtual%20layer%20provider%20offers%20to%20satisfy%20an%20%60%3D%60%0A--%20on%20a%20layer's%20primary%20key%20itself,%20then%20honours%20it%20with%20setFilterFid(sqlite3_value_int()),%0A--%20coercing%20the%20key%20to%20an%20integer%20feature%20id%20--%20so%20a%20uuid%20join%20asks%20for%20feature%200%20and%0A--%20sign-%3Eframe%20matched%200%20of%2034%20rows,%20silently.%20Casting%20inside%20the%20ON%20clause%20blocks%20that%0A--%20push-down%20and%20fixes%20the%20result,%20but%20also%20defeats%20SQLite's%20index%20use,%20turning%20every%20join%0A--%20into%20a%20per-row%20provider%20lookup%20(a%2034-sign%20project%20did%20not%20finish%20in%209%20minutes).%0A--%20Normalising%20each%20source%20once%20into%20a%20MATERIALIZED%20CTE%20gives%20both.%0A--%20Text%20and%20integer%20keys%20(official_sign.id,%20marker_type.id)%20are%20unaffected,%20but%20are%20carried%0A--%20through%20the%20same%20CTEs%20to%20keep%20the%20shape%20uniform.%0A--%20Fixed%20upstream%20by%20QGIS%205cb8ed11a09%20(master%20and%204.2,%20not%203.44):%20these%20CTEs%20can%20become%0A--%20plain%20joins%20once%20the%20QGIS%20floor%20--%20desktop%20and%20the%20one%20QField%20embeds%20--%20is%20past%203.44.%0A--%20%60_azimut_rectified%60%20keeps%20the%20view's%20asymmetry%20(+180%20with%20no%20%25%20360)%20on%20purpose,%20so%0A--%20the%20two%20layers%20stay%20comparable%20row%20for%20row.%0AWITH%20sign_n%20AS%20MATERIALIZED%20(%0A%20%20%20%20SELECT%0A%20%20%20%20%20%20%20%20CAST(id%20AS%20TEXT)%20AS%20id,%0A%20%20%20%20%20%20%20%20CAST(fk_frame%20AS%20TEXT)%20AS%20fk_frame,%0A%20%20%20%20%20%20%20%20CAST(fk_user_sign%20AS%20TEXT)%20AS%20fk_user_sign,%0A%20%20%20%20%20%20%20%20rank,%20fk_hanging_mode,%20natural_direction_or_left,%20fk_sign_type,%20complex,%0A%20%20%20%20%20%20%20%20fk_official_sign,%20fk_marker_type,%20fk_mirror_shape,%20mirror_red_frame,%0A%20%20%20%20%20%20%20%20inscription_1,%20inscription_2,%20inscription_3%0A%20%20%20%20FROM%20sign%0A),%0Aframe_n%20AS%20MATERIALIZED%20(%0A%20%20%20%20SELECT%20CAST(id%20AS%20TEXT)%20AS%20id,%20CAST(fk_azimut%20AS%20TEXT)%20AS%20fk_azimut,%20rank,%20fk_mounting_point%0A%20%20%20%20FROM%20frame%0A),%0Aazimut_n%20AS%20MATERIALIZED%20(%0A%20%20%20%20SELECT%20CAST(id%20AS%20TEXT)%20AS%20id,%20CAST(fk_support%20AS%20TEXT)%20AS%20fk_support,%0A%20%20%20%20%20%20%20%20%20%20%20azimut,%20offset_x,%20offset_y,%20offset_x_verso,%20offset_y_verso%0A%20%20%20%20FROM%20azimut%0A),%0Asupport_n%20AS%20MATERIALIZED%20(%0A%20%20%20%20SELECT%20CAST(id%20AS%20TEXT)%20AS%20id,%20geometry,%20group_by_mounting_point,%20fk_support_type%0A%20%20%20%20FROM%20support%0A),%0Aofficial_sign_n%20AS%20MATERIALIZED%20(%0A%20%20%20%20SELECT%20CAST(id%20AS%20TEXT)%20AS%20id,%20directional_sign,%20value_fr,%0A%20%20%20%20%20%20%20%20%20%20%20img_de,%20img_fr,%20img_it,%20img_ro,%20img_de_right,%20img_fr_right,%20img_it_right,%20img_ro_right,%0A%20%20%20%20%20%20%20%20%20%20%20img_height,%20img_width%0A%20%20%20%20FROM%20official_sign%0A),%0Auser_sign_n%20AS%20MATERIALIZED%20(%0A%20%20%20%20SELECT%20CAST(id%20AS%20TEXT)%20AS%20id,%20directional_sign,%20value_fr,%0A%20%20%20%20%20%20%20%20%20%20%20img_de,%20img_fr,%20img_it,%20img_ro,%20img_de_right,%20img_fr_right,%20img_it_right,%20img_ro_right,%0A%20%20%20%20%20%20%20%20%20%20%20img_height,%20img_width%0A%20%20%20%20FROM%20user_sign%0A),%0Amarker_type_n%20AS%20MATERIALIZED%20(%0A%20%20%20%20SELECT%20id,%20directional_sign,%20value_fr,%0A%20%20%20%20%20%20%20%20%20%20%20img_de,%20img_fr,%20img_it,%20img_ro,%20img_de_right,%20img_fr_right,%20img_it_right,%20img_ro_right,%0A%20%20%20%20%20%20%20%20%20%20%20img_height,%20img_width%0A%20%20%20%20FROM%20marker_type%0A),%0Ajoined_tables%20AS%20(%0A%20%20%20%20SELECT%0A%20%20%20%20%20%20%20%20sign.id%20AS%20id,%0A%20%20%20%20%20%20%20%20sign.rank%20AS%20sign_rank,%0A%20%20%20%20%20%20%20%20sign.fk_hanging_mode%20AS%20sign_fk_hanging_mode,%0A%20%20%20%20%20%20%20%20sign.natural_direction_or_left%20AS%20sign_natural_direction_or_left,%0A%20%20%20%20%20%20%20%20sign.fk_sign_type%20AS%20sign_fk_sign_type,%0A%20%20%20%20%20%20