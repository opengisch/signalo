                          <Option name="expression" type="QString" value="(CASE WHEN @vector_tile_zoom >= 7 AND @vector_tile_zoom &lt;= 8 THEN (scale_exponential(@vector_tile_zoom,7,8,0,CASE WHEN &quot;is_route&quot; IN (5, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 1.5 ELSE 3 END WHEN &quot;class&quot; = 'trunk' THEN 3 ELSE 3 END ELSE 0 END,2)) * 0.264583 WHEN @vector_tile_zoom > 8 AND @vector_tile_zoom &lt;= 9 THEN (scale_exponential(@vector_tile_zoom,8,9,CASE WHEN &quot;is_route&quot; IN (5, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 1.5 ELSE 3 END WHEN &quot;class&quot; = 'trunk' THEN 3 ELSE 3 END ELSE 0 END,CASE WHEN &quot;is_route&quot; IN (5, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2 ELSE 3.5 END WHEN &quot;class&quot; = 'trunk' THEN 3.5 ELSE 3 END ELSE 0 END,2)) * 0.264583 WHEN @vector_tile_zoom > 9 AND @vector_tile_zoom &lt;= 10 THEN (scale_exponential(@vector_tile_zoom,9,10,CASE WHEN &quot;is_route&quot; IN (5, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2 ELSE 3.5 END WHEN &quot;class&quot; = 'trunk' THEN 3.5 ELSE 3 END ELSE 0 END,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2 ELSE 4 END WHEN &quot;class&quot; = 'trunk' THEN 4 WHEN (&quot;class&quot; = 'primary') THEN 3.5 WHEN (&quot;class&quot; = 'secondary') THEN 3.5 WHEN (&quot;class&quot; = 'tertiary') THEN 3 WHEN &quot;class&quot; IN ('minor', 'service') THEN 2.5 ELSE 0 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 2 ELSE 0 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 10 AND @vector_tile_zoom &lt;= 11 THEN (scale_exponential(@vector_tile_zoom,10,11,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2 ELSE 4 END WHEN &quot;class&quot; = 'trunk' THEN 4 WHEN (&quot;class&quot; = 'primary') THEN 3.5 WHEN (&quot;class&quot; = 'secondary') THEN 3.5 WHEN (&quot;class&quot; = 'tertiary') THEN 3 WHEN &quot;class&quot; IN ('minor', 'service') THEN 2.5 ELSE 0 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 2 ELSE 0 END END,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2.5 ELSE 4.5 END WHEN &quot;class&quot; = 'trunk' THEN 4.5 WHEN (&quot;class&quot; = 'primary') THEN 4 WHEN (&quot;class&quot; = 'secondary') THEN 4 WHEN (&quot;class&quot; = 'tertiary') THEN 3.5 WHEN &quot;class&quot; IN ('minor', 'service') THEN 2.75 WHEN &quot;class&quot; IN ('track', 'path', 'footway') THEN 0.5 ELSE 0 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 2.5 ELSE 0 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 11 AND @vector_tile_zoom &lt;= 12 THEN (scale_exponential(@vector_tile_zoom,11,12,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2.5 ELSE 4.5 END WHEN &quot;class&quot; = 'trunk' THEN 4.5 WHEN (&quot;class&quot; = 'primary') THEN 4 WHEN (&quot;class&quot; = 'secondary') THEN 4 WHEN (&quot;class&quot; = 'tertiary') THEN 3.5 WHEN &quot;class&quot; IN ('minor', 'service') THEN 2.75 WHEN &quot;class&quot; IN ('track', 'path', 'footway') THEN 0.5 ELSE 0 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 2.5 ELSE 0 END END,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; IN ('motorway', 'trunk') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2.75 ELSE 5 END WHEN (&quot;class&quot; = 'primary') THEN 5 WHEN (&quot;class&quot; = 'secondary') THEN 4.5 WHEN (&quot;class&quot; = 'tertiary') THEN 4 WHEN &quot;class&quot; IN ('minor', 'service') THEN 3 WHEN &quot;class&quot; IN ('track', 'path', 'footway') THEN 0.75 ELSE 0 END WHEN &quot;is_route&quot; = 11 THEN CASE WHEN &quot;class&quot; IN ('motorway', 'trunk', 'primary', 'secondary', 'tertiary', 'minor') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2.75 ELSE 0.75 END WHEN &quot;class&quot; IN ('track', 'path', 'footway') THEN 0.5 ELSE 0 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 2.75 ELSE 0 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 12 AND @vector_tile_zoom &lt;= 13 THEN (scale_exponential(@vector_tile_zoom,12,13,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; IN ('motorway', 'trunk') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2.75 ELSE 5 END WHEN (&quot;class&quot; = 'primary') THEN 5 WHEN (&quot;class&quot; = 'secondary') THEN 4.5 WHEN (&quot;class&quot; = 'tertiary') THEN 4 WHEN &quot;class&quot; IN ('minor', 'service') THEN 3 WHEN &quot;class&quot; IN ('track', 'path', 'footway') THEN 0.75 ELSE 0 END WHEN &quot;is_route&quot; = 11 THEN CASE WHEN &quot;class&quot; IN ('motorway', 'trunk', 'primary', 'secondary', 'tertiary', 'minor') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 2.75 ELSE 0.75 END WHEN &quot;class&quot; IN ('track', 'path', 'footway') THEN 0.5 ELSE 0 END ELSE CASE WHEN (&quot;ramp&quot; = 1) THEN 2.75 ELSE 0 END END,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 3 ELSE 6 END WHEN &quot;class&quot; = 'trunk' THEN 6 WHEN (&quot;class&quot; = 'primary') THEN 5.5 WHEN (&quot;class&quot; = 'secondary') THEN 5 WHEN (&quot;class&quot; = 'tertiary') THEN 4.5 WHEN &quot;class&quot; IN ('minor', 'service') THEN 3.5 WHEN &quot;class&quot; IN ('track', 'path', 'footway') THEN CASE WHEN (&quot;subclass&quot; = 'covered_bridge') THEN 3 ELSE 1 END ELSE 3 END WHEN (&quot;is_route&quot; = 11) THEN CASE WHEN &quot;class&quot; IN ('motorway', 'trunk') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 3 ELSE 6 END WHEN (&quot;class&quot; = 'primary') THEN 4 WHEN (&quot;class&quot; = 'secondary') THEN 3.75 WHEN (&quot;class&quot; = 'tertiary') THEN 3.75 WHEN &quot;class&quot; IN ('minor', 'service') THEN 3 WHEN &quot;class&quot; IN ('track', 'path', 'footway') THEN CASE WHEN (&quot;subclass&quot; = 'covered_bridge') THEN 3 ELSE 0.5 END ELSE 3 END ELSE 0 END,2)) * 0.264583 WHEN @vector_tile_zoom > 13 AND @vector_tile_zoom &lt;= 14 THEN (scale_exponential(@vector_tile_zoom,13,14,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 3 ELSE 6 END WHEN &quot;class&quot; = 'trunk' THEN 6 WHEN (&quot;class&quot; = 'primary') THEN 5.5 WHEN (&quot;class&quot; = 'secondary') THEN 5 WHEN (&quot;class&quot; = 'tertiary') THEN 4.5 WHEN &quot;class&quot; IN ('minor', 'service') THEN 3.5 WHEN &quot;class&quot; IN ('track', 'path', 'footway') THEN CASE WHEN (&quot;subclass&quot; = 'covered_bridge') THEN 3 ELSE 1 END ELSE 3 END WHEN (&quot;is_route&quot; = 11) THEN CASE WHEN &quot;class&quot; IN ('motorway', 'trunk') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 3 ELSE 6 END WHEN (&quot;class&quot; = 'primary') THEN 4 WHEN (&quot;class&quot; = 'secondary') THEN 3.75 WHEN (&quot;class&quot; = 'tertiary') THEN 3.75 WHEN &quot;class&quot; IN ('minor', 'service') THEN 3 WHEN &quot;class&quot; IN ('track', 'path', 'footway') THEN CASE WHEN (&quot;subclass&quot; = 'covered_bridge') THEN 3 ELSE 0.5 END ELSE 3 END ELSE 0 END,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 4 ELSE 7 END WHEN &quot;class&quot; = 'trunk' THEN 7 WHEN (&quot;class&quot; = 'primary') THEN 6.5 WHEN (&quot;class&quot; = 'secondary') THEN 6 WHEN (&quot;class&quot; = 'tertiary') THEN 5 WHEN &quot;class&quot; IN ('minor', 'service') THEN 4 WHEN &quot;class&quot; IN ('track', 'path', 'footway') THEN CASE WHEN (&quot;subclass&quot; = 'covered_bridge') THEN 3.5 ELSE 0.75 END ELSE 3.5 END ELSE CASE WHEN &quot;class&quot; IN ('motorway', 'trunk') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 4 ELSE 7 END WHEN (&quot;class&quot; = 'primary') THEN 4.5 WHEN (&quot;class&quot; = 'secondary') THEN 4 WHEN (&quot;class&quot; = 'tertiary') THEN 4 WHEN &quot;class&quot; IN ('minor', 'service') THEN 3.5 WHEN &quot;class&quot; IN ('track', 'path', 'footway') THEN CASE WHEN (&quot;subclass&quot; = 'covered_bridge') THEN 3.5 ELSE 0.75 END ELSE 3.5 END END,2)) * 0.264583 WHEN @vector_tile_zoom > 14 AND @vector_tile_zoom &lt;= 15 THEN (scale_exponential(@vector_tile_zoom,14,15,CASE WHEN &quot;is_route&quot; IN (5, 6, 7, 8, 10, 99) THEN CASE WHEN &quot;class&quot; = 'motorway' THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 4 ELSE 7 END WHEN &quot;class&quot; = 'trunk' THEN 7 WHEN (&quot;class&quot; = 'primary') THEN 6.5 WHEN (&quot;class&quot; = 'secondary') THEN 6 WHEN (&quot;class&quot; = 'tertiary') THEN 5 WHEN &quot;class&quot; IN ('minor', 'service') THEN 4 WHEN &quot;class&quot; IN ('track', 'path', 'footway') THEN CASE WHEN (&quot;subclass&quot; = 'covered_bridge') THEN 3.5 ELSE 0.75 END ELSE 3.5 END ELSE CASE WHEN &quot;class&quot; IN ('motorway', 'trunk') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 4 ELSE 7 END WHEN (&quot;class&quot; = 'primary') THEN 4.5 WHEN (&quot;class&quot; = 'secondary') THEN 4 WHEN (&quot;class&quot; = 'tertiary') THEN 4 WHEN &quot;class&quot; IN ('minor', 'service') THEN 3.5 WHEN &quot;class&quot; IN ('track', 'path', 'footway') THEN CASE WHEN (&quot;subclass&quot; = 'covered_bridge') THEN 3.5 ELSE 0.75 END ELSE 3.5 END END,CASE WHEN &quot;class&quot; IN ('motorway', 'motorway_construction') THEN CASE WHEN (&quot;ramp&quot; = 1) THEN 6.5 ELSE 8 END WHEN &quot;class&quot; IN ('trunk', 'trunk_construction') THEN CASE WHEN (&quot;oneway&quot; = 1) THEN 8 ELSE 12 END WHEN &quot;class&quot; IN ('primary', 'primary_construction') THEN 8 WHEN &quot;class&quot; IN ('secondary', 'secondary_construction') THEN 7 WHEN &quot;class&quot; IN ('tertiary', 'tertiary_construction') THEN 6 WHEN &quot;class&quot; IN ('minor', 'minor_construction', 'service', 