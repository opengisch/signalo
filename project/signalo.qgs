                          <Option name="name" type="Map">
                            <Option name="active" type="bool" value="true"></Option>
                            <Option name="expression" type="QString" value="'images/' ||&#xA;CASE&#xA;WHEN &quot;sign_fk_sign_type&quot; = 11 and &quot;sign_complex&quot; is not true THEN 'official/editable/'&#xA;WHEN &quot;sign_fk_sign_type&quot; = 12 &#xA;THEN 'marker/editable/'&#xA;WHEN &quot;sign_fk_sign_type&quot; = 15 &#xA;THEN 'user-defined/editable/'&#xA;ELSE 'other/editable/'&#xA;END&#xA;||&#xA;attribute('_img_'|| if(@qgis_locale IN ('de', 'fr', 'it', 'ro'), @qgis_locale, 'fr')   || &quot;_img_direction&quot; )"></Option>
                            <Option name="type" type="int" value="3"></Option>
                          </Option>
                          <Option name="offset" type="Map">
                            <Option name="active" type="bool" value="true"></Option>
                            <Option name="expression" type="QString" value="array(&#xA;if(_verso, -1, 1) *&#xA;CASE WHEN &quot;frame_fk_mounting_point&quot; IS  'center' THEN 0&#xA;WHEN   &quot;frame_fk_mounting_point&quot; IS 'left' THEN 1&#xA;WHEN  &quot;frame_fk_mounting_point&quot; IS  'right' THEN -1&#xA;END&#xA;* @signalo_img_size *  &quot;_group_width&quot; / 2 / 100&#xA;+  &quot;_azimut_offset_x_rectified&quot; * @signalo_img_size&#xA;-- X&#xA;,(&quot;_final_rank&quot;-1)*2 + @signalo_img_size*(0.2+coalesce( &quot;_symbol_shift&quot;,0)/100) &#xA;+  &quot;_azimut_offset_y_rectified&quot; * @signalo_img_size&#xA;-- Y&#xA;)"></Option>
                            <Option name="type" type="int" value="3"></Option>
                          </Option>
                          <Option name="vAnchor" type="Map">
                            <Option name="active" type="bool" value="true"></Option>
                            <Option name="expression" type="QString" value="'top'"></Option>
                            <Option name="type" type="int" value="3"></Option>
                          </Option>
                          <Option name="width" type="Map">
