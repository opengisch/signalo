                      <Option name="expression" type="QString" value="CASE WHEN &quot;class&quot; IS 'scree' THEN '#6e6e6e' WHEN &quot;class&quot; IS 'land' THEN '#b3884d' WHEN &quot;class&quot; IS 'water' THEN '#2f86bc' WHEN &quot;class&quot; IS 'ice' THEN '#507b95' ELSE '#6e6e6e' END"></Option>
