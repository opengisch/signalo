                            <Option name="expression" type="QString" value="'images/' ||&#xa;CASE&#xa;WHEN &quot;sign_fk_sign_type&quot; = 11 and &quot;sign_complex&quot; is not true THEN 'official/editable/'&#xa;WHEN &quot;sign_fk_sign_type&quot; = 12 &#xa;THEN 'marker/editable/'&#xa;WHEN &quot;sign_fk_sign_type&quot; = 15 &#xa;THEN 'user-defined/editable/'&#xa;ELSE 'other/editable/'&#xa;END&#xa;||&#xa;attribute('_img_'|| if(@qgis_locale IN ('de', 'fr', 'it', 'ro'), @qgis_locale, 'fr')   || &quot;_img_direction&quot; )"/>
                            <Option name="type" type="int" value="3"/>
