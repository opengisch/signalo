              <rules key="{70799911-cf7d-489d-b6ca-2b8082fa6923}">
                <rule filter=" (@qgis_platform = 'desktop' or &#xA; ( &#xA;&quot;support__edited&quot; is not true and &quot;azimut__edited&quot; is not true and  &quot;sign__edited&quot; is not true and  &quot;frame__edited&quot; is not true&#xA; )) and (&#xA; &#xA;--   4.  Signaux d'indication&#xA;-- 4.1 Signaux impliquant des règles de comportement (4.01-4.25)&#xA;(&quot;sign_fk_official_sign&quot; like '4.0%' &#xA;or &quot;sign_fk_official_sign&quot; like '4.1%'&#xA;or &quot;sign_fk_official_sign&quot; in ('4.20','4.22','4.23','4.24')&#xA;or &quot;sign_fk_official_sign&quot; like '4.21%'&#xA;or &quot;sign_fk_official_sign&quot; like '4.25%')&#xA;&#xA;&#xA;-- 4.2 Direction indication signs on main roads and secondary roads (4.27-4.59.1)&#xA;&#xA;or &#xA;(&quot;sign_fk_official_sign&quot; like '4.27%' &#xA;or &quot;sign_fk_official_sign&quot; = '4.28'&#xA;or &quot;sign_fk_official_sign&quot; like '4.29%' &#xA;or &quot;sign_fk_official_sign&quot; like '4.3%'&#xA;or &quot;sign_fk_official_sign&quot; like '4.4%'&#xA;or &quot;sign_fk_official_sign&quot; like '4.5%')&#xA;&#xA;-- 4.3 Direction indication signs motorways and semi-motorways (4.60-4.73)&#xA;or&#xA;(&quot;sign_fk_official_sign&quot; like '4.6%'&#xA;or &quot;sign_fk_official_sign&quot; in ('4.70','4.71','4.72','4.73'))&#xA;&#xA;-- 4.4 Informations (4.75-4.95)&#xA;or &#xA;(&quot;sign_fk_official_sign&quot; in ('4.75','4.76','4.79')&#xA;or &quot;sign_fk_official_sign&quot; like '4.77%'&#xA;or &quot;sign_fk_official_sign&quot; like '4.8%'&#xA;or &quot;sign_fk_official_sign&quot; like '4.9%')&#xA;&#xA;-- keep this parenthesis!&#xA;)" key="{9fb3def5-e8b7-4825-add6-4b0041e8e0a6}" label="Signaux" symbol="0"></rule>
              </rules>
